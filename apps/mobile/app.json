{
  "expo": {
    "name": "Tripwave",
    "slug": "together",
    "scheme": "together",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#B97A22"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tripwave usa suas fotos pra você postar no feed da viagem.",
          "cameraPermission": "O Tripwave usa a câmera pra você tirar fotos e postar no feed da viagem."
        }
      ]
    ]
  }
}
